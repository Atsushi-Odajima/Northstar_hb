{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"] },
    "types": ["node"]
  },
  "include": ["server", "shared", "scripts", "tests", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
