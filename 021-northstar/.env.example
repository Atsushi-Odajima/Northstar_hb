# Northstar server configuration (copy to .env). Never commit real secrets.
PORT=8787
HOST=0.0.0.0
# SQLite database file (default ./data/northstar.db). Use an absolute path in production.
NORTHSTAR_DB=./data/northstar.db
# 32+ random bytes, base64. Used to sign session cookies / CSRF tokens. REQUIRED in production.
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32
# Set to "true" behind HTTPS (Secure cookies). Set APP_ORIGIN to the public origin for CSRF checks.
SECURE_COOKIES=false
APP_ORIGIN=http://localhost:5173
# Allow new account sign-up (set false after creating your own account on a private deployment)
ALLOW_SIGNUP=true
# ---- AI (all optional; AI is OFF until the user enables it in Settings) ----
# Provider keys are server-side only and never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL (e.g. a self-hosted gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
# ---- Web Push (optional). Generate with: pnpm tsx scripts/vapid.ts ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# ---- Backups ----
BACKUP_DIR=./data/backups
LOG_LEVEL=info
# Auth rate limit per IP per minute (signup/login). Default 10.
AUTH_RATE_LIMIT_PER_MIN=10
